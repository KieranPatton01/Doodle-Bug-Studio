# Doodlebug PWA Client Environment Configuration
# All values here are client-side public identifiers (scoped strictly to Firebase Auth)
# Photos are uploaded to the GitHub img/ folder via the Cloudflare Worker.
# NEVER put GitHub PAT or Gemini API Keys here.

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Cloudflare Worker Gateway endpoint
VITE_WORKER_URL=https://doodlebug-gateway.<your-account>.workers.dev
